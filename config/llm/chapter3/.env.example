# Chapter 3 only. Copy to .env.private; never copy Chapter 2 credentials.
# Select the same public endpoint as your Chapter 2 provider:
# XCM: https://xcmapi.org/v1 ; Qwen proxy: https://api.sqhtoken.com/v1
CHAPTER3_BASE_URL=https://xcmapi.org/v1
CHAPTER3_MODEL=deepseek-v4.1-flash
CHAPTER3_API_KEY=
# DSH pi-ai wire protocol: openai-completions or openai-responses
CHAPTER3_API=openai-completions
CHAPTER3_CONTEXT_WINDOW=32768
CHAPTER3_MAX_OUTPUT_TOKENS=4096
