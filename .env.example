# DSH host/profile integration. Keep these relative in the tracked template;
# replace them with machine-local absolute paths outside Git when deploying.
PRINCIPIA_PROJECT_ROOT=.
PRINCIPIA_PYTHON=.venv/bin/python

# Files are read from an external tutorial tree; resolve this path from the
# project working directory or replace it in your uncommitted .env file.
BLASTFOAM_TUTORIALS=../blastFoam_tutorials

# MCP domain tools may only access cases inside this root. Relative paths are
# resolved from the repository root.
PRINCIPIA_CASE_ROOT=outputs

# Optional. Deterministic MCP lookups work without an LLM key.
RETRIEVAL_LLM_API_KEY=
RETRIEVAL_LLM_API_BASE_URL=
RETRIEVAL_LLM_MODEL=deepseek-chat
RETRIEVAL_LLM_PROVIDER=deepseek

# Bound the in-process candidate-to-detail cache.
MCP_RETRIEVAL_DETAIL_CACHE_SIZE=200

# Real solver execution is the project default. Set both flags to false for a
# configuration-only/CI session. Preflight still blocks invalid environments.
ENABLE_EXECUTION=true
REQUIRE_EXECUTION=true
# Set the bashrc paths for an unsourced host environment, or leave them empty
# only when the MCP process already inherits OpenFOAM in PATH.
OPENFOAM_BASHRC=
BLASTFOAM_BASHRC=
OPENFOAM_EXECUTION_USER=
PRINCIPIA_EXECUTION_TIMEOUT_SECONDS=3600
PRINCIPIA_MIN_EXECUTION_TIMEOUT_SECONDS=180
PRINCIPIA_SMOKE_MAX_END_TIME=0.0005
